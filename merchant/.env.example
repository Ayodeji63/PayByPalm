PORT=8093
APP_ORIGIN=http://127.0.0.1:5193
# Production: NODE_ENV=production and APP_ORIGIN=https://merchant.paybypalm.app
# Vercel: NODEJS_HELPERS=0, TRUST_PROXY_HOPS=1
TRUST_PROXY_HOPS=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
PAYMENT_API_BASE_URL=https://paybypalm-backend.onrender.com
# Reports and Paystack reads run on the payment backend. No Paystack/Tencent key here.

# Login/verification uses PAYMENT_API_BASE_URL. No Resend key or auth DB password here.
