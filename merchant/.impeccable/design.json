  "narrative": {
    "northStar": "PayByPalm merchant workspace",
    "overview": "The merchant app inherits the established PayByPalm blue identity: white work surfaces, navy text, restrained borders and tabular financial amounts. Compact controls and labelled statuses support reviewing business records, with a visibly separate Merchant workspace identity.\n\nThis is the built system, extracted from src/style.css, src/main.tsx and src/icons.tsx and checked against the desktop and mobile browser captures. The parent identity authority is ../admin/DESIGN.md; merchant-specific dimensions and states below describe this implementation. The operational overview and reconciliation rail belong to the surface contract in index.html, rather than defining every future screen.",
    "keyCharacteristics": [
      "PayByPalm blue actions and pale blue selections.",
      "White bordered surfaces on a cool neutral canvas.",
      "Compact sans typography and aligned financial amounts.",
      "Responsive navigation, semantic tables and explicit status words."
    ],
    "rules": [
      {
        "name": "The Worded State Rule",
        "body": "Pair semantic color with a status word or explanatory message; color alone never states the payment outcome, payout state or environment.",
        "section": "colors"
      },
      {
        "name": "The Separate Money States Rule",
        "body": "Keep payment receipt and bank settlement explicitly separate in labels, summaries and detail views.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep PayByPalm blue, white surfaces and the cool neutral canvas.",
      "Do label controls, preserve visible focus and keep the skip link available to keyboard users.",
      "Do keep payments, provider settlement and terminal contact as distinct facts.",
      "Do format money as NGN with two decimals and present record dates in Africa/Lagos.",
      "Do preserve table columns in a horizontal scroll region on small screens.",
      "Do show unavailable, loading and error states with explanatory text."
    ],
    "donts": [
      "Don't treat a paid card payment as a completed bank settlement.",
      "Don't replace provider errors with zero balances or empty-success reports.",
      "Don't interpret a last-contact timestamp as a live online status.",
      "Don't turn read-only business or payout information into editing controls.",
      "Don't promote browser fixture records or their demonstration banner into production design content."
    ]
  }
}
