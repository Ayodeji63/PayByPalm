{
  "name": "paybypalm-merchant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:database": "python3 tests/database.py",
    "preflight": "tsx scripts/preflight.ts",
    "guard:secrets": "tsx scripts/guard-secrets.ts",
    "deploy:vercel": "node scripts/deploy-vercel.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "express": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.12",
    "zod": "3.25.76",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@11.22.0"
}
