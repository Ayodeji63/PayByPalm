# PayByPalm backend — copy to .env and fill in.
# Every variable here is parsed and validated at boot by src/config.ts.
# The process refuses to start if a required one is missing or malformed.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Bypasses row-level security — it is the only credential in this system
# that can write to the database. It belongs in backend env vars and nowhere else:
# never in the wallet app, never on the Pi, never in a response body.
SUPABASE_SERVICE_ROLE_KEY=

# Public key, safe to ship to clients. The backend uses it only to verify user
# logins against Supabase Auth.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Palm provider
# ---------------------------------------------------------------------------
# tencent = the real Tencent PalmAI service.
# mock    = deterministic in-memory matching, zero network. The whole app is
#           demoable end to end on mock with no Tencent access at all.
PALM_PROVIDER=mock

TENCENT_BASE_URL=https://open.intl.palm.tencent.com

# SECRET. Read in exactly one file — src/palm/tencent.ts. Sent as a raw
# Tencent credential only; the backend adds the required "Bearer " prefix.
# Required only when PALM_PROVIDER=tencent.
TENCENT_PALM_API_KEY=

# Score the mock provider returns on a known palm. Set to 90 / 78 / 50 to exercise
# the accept / step_up / reject branches of the match policy without a network.
MOCK_PALM_SCORE=92

# ---------------------------------------------------------------------------
# Match policy — OUR thresholds, not the provider's own verdict
# ---------------------------------------------------------------------------
#   score >= PALM_ACCEPT_SCORE           -> accept
#   PALM_STEP_UP_SCORE <= score < accept -> step_up (wallet PIN on the terminal)
#   score <  PALM_STEP_UP_SCORE          -> reject
#
# These defaults are a starting point, not calibrated numbers. Every call is
# logged to palm_audit with its score; tune from that data on the real camera and
# kiosk lighting before demo day.
PALM_ACCEPT_SCORE=85
PALM_STEP_UP_SCORE=70

# Maximum candidates the last4 bin may expand to before the terminal asks for more
# digits. Above this, one payment would fan out into many biometric comparisons.
MAX_CANDIDATES=4

# ---------------------------------------------------------------------------
# Timings
# ---------------------------------------------------------------------------
# Enrolment QR lifetime. A stale QR left on a terminal screen must not stay claimable.
ENROL_SESSION_TTL_SECONDS=90

# How long a palm match stays spendable. Confirm after this window is rejected.
AUTH_VALIDITY_SECONDS=60

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Public origin of the wallet app. Used to build the enrolment link encoded into
# the terminal's QR code, and as the CORS allow-list.
WALLET_BASE_URL=http://localhost:5173

# Comma-separated extra origins allowed to call this API (e.g. the terminal app).
# WALLET_BASE_URL is always allowed and does not need repeating here.
EXTRA_CORS_ORIGINS=

# Max accepted palm image size. Base64 inflates by ~33%, so this is compared
# against the decoded byte length.
MAX_IMAGE_BYTES=2097152
