# PayByPalm backend — copy to .env and fill in.
# Every variable here is parsed and validated at boot by src/config.ts.
# The process refuses to start if a required one is missing or malformed.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Bypasses row-level security — it is the only credential in this system
# that can write to the database. It belongs in backend env vars and nowhere else:
# never in the wallet app, never on the Pi, never in a response body.
SUPABASE_SERVICE_ROLE_KEY=

# Accounts/passwords/sessions are owned by Better Auth; Supabase stores the data.
# Legacy tooling may still define SUPABASE_ANON_KEY, but runtime Auth does not use it.

# ---------------------------------------------------------------------------
# Better Auth + Resend (backend only; never use VITE_ prefixes)
# ---------------------------------------------------------------------------
# Supabase Connect -> Session pooler -> PostgreSQL URI, with the DB password.
# TLS certificate validation is required; do not use sslmode=no-verify.
AUTH_DATABASE_URL=
# Generate once with pnpm auth:prepare; keep this same secret across deployments.
AUTH_SECRET=
AUTH_BASE_URL=https://paybypalm-backend.onrender.com
RESEND_API_KEY=
# Bare email address on your verified Resend domain, e.g. auth@paybypalm.app.
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Palm provider
# ---------------------------------------------------------------------------
# ccnet = local CCNet over its fixed HTTPS tunnel. Tencent selection is disabled.
# mock    = deterministic in-memory matching, zero network. The whole app is
#           demoable end to end on mock with no Tencent access at all.
PALM_PROVIDER=mock
# Production uses ccnet. Keep this credential on the backend only.
CCNET_BASE_URL=
CCNET_API_KEY=
CCNET_MATCH_TIMEOUT_MS=5000
CCNET_ENROLL_TIMEOUT_MS=20000

TENCENT_BASE_URL=https://open.intl.palm.tencent.com

# SECRET. Read in exactly one file — src/palm/tencent.ts. Sent as a raw
# Tencent credential only; the backend adds the required "Bearer " prefix.
# Required only when PALM_PROVIDER=tencent.
TENCENT_PALM_API_KEY=
# H5 capture-only skips video upload. Leave false until Tencent confirms the
# application's image-only liveness and cross-user comparison support. Test-card
# mode permits compatibility testing without enabling live card charges.
TENCENT_H5_IMAGE_ONLY_APPROVED=false
# Original terminal camera by default; opt in to the retained H5 implementation.
TENCENT_CAPTURE_MODE=legacy

# Score the mock provider returns on a known palm. Set to 90 / 78 / 50 to exercise
# the accept / step_up / reject branches of the match policy without a network.
MOCK_PALM_SCORE=92

# ---------------------------------------------------------------------------
# Match policy — OUR thresholds, not the provider's own verdict
# ---------------------------------------------------------------------------
#   score >= PALM_ACCEPT_SCORE           -> accept
#   PALM_STEP_UP_SCORE <= score < accept -> step_up (checkout still requires a new scan)
#   score <  PALM_STEP_UP_SCORE          -> reject
#
# These defaults are a starting point, not calibrated numbers. Every call is
# logged to palm_audit with its score; tune from that data on the real camera and
# kiosk lighting before demo day.
PALM_ACCEPT_SCORE=50
PALM_STEP_UP_SCORE=40

# Maximum candidates the last4 bin may expand to before the terminal asks for more
# digits. Above this, one payment would fan out into many biometric comparisons.
MAX_CANDIDATES=4

# ---------------------------------------------------------------------------
# Timings
# ---------------------------------------------------------------------------
# Enrolment QR lifetime. A stale QR left on a terminal screen must not stay claimable.
ENROL_SESSION_TTL_SECONDS=300

# How long a palm match stays spendable. Confirm after this window is rejected.
AUTH_VALIDITY_SECONDS=60

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Public origin of the wallet app. Used to build the enrolment link encoded into
# the terminal's QR code, and as the CORS allow-list.
WALLET_BASE_URL=http://localhost:5173

# Comma-separated extra origins allowed to call this API (e.g. the terminal app).
# WALLET_BASE_URL is always allowed and does not need repeating here.
# Production custom domains (set on Render, not on the wallet/Vercel service):
# EXTRA_CORS_ORIGINS=https://www.paybypalm.app,https://paybypalm.app
# Use exact origins: https://, no paths or trailing slash. Keep any other needed origins.
EXTRA_CORS_ORIGINS=

# Max accepted palm image size. Base64 inflates by ~33%, so this is compared
# against the decoded byte length.
MAX_IMAGE_BYTES=2097152

# Direct access: 0. Set 1 only behind one trusted proxy that appends client IPs.
TRUST_PROXY_HOPS=0

# Card linking: Paystack secret key belongs on the backend only. Never use a VITE_ prefix.
# Keep absent to leave the integration unconfigured without blocking wallet login.
# Single source of truth: wallet reads mode from the API. Switch together with the matching secret.
# Apply migrations through 0031 once; preserve CARD_TOKEN_ENCRYPTION_KEY when switching.
PAYSTACK_MODE=test
# PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
# Generate once with: openssl rand -base64 32
# Back up this encryption key securely; changing it requires explicit token migration.
# CARD_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# New operations use this provider; existing attempts recover with their saved provider.
PAYMENT_PROVIDER=paystack
# Optional: overrides PAYSTACK_MODE for new operations with either provider.
# PAYMENT_MODE=test
# Optional separate keys keep recovery working across test/live switches.
# PAYSTACK_TEST_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
# PAYSTACK_LIVE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_KEY
# Flutterwave v3 credentials: backend only. Never put secrets in the wallet or Pi.
# FLUTTERWAVE_TEST_SECRET_KEY=FLWSECK_TEST-REPLACE_WITH_YOUR_KEY-X
# FLUTTERWAVE_LIVE_SECRET_KEY=FLWSECK-REPLACE_WITH_YOUR_KEY-X
# Generate a webhook hash with: openssl rand -hex 32
# FLUTTERWAVE_WEBHOOK_HASH=REPLACE_WITH_RANDOM_PRIVATE_32_OR_MORE_CHARACTERS
# Enable only after Flutterwave approves NOAUTH tokenized charges for this account.
FLUTTERWAVE_NOAUTH_APPROVED=false
# Deployment, relinking, subaccounts, refunds and switching: PAYMENT_PROVIDERS.md
