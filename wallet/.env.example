# PayByPalm wallet — copy to .env and fill in.
#
# EVERYTHING HERE IS PUBLIC. Vite inlines every VITE_* variable into the JavaScript
# bundle it ships to the browser, so treat this file as world-readable.
#
# Do NOT put here:
#   - SUPABASE_SERVICE_ROLE_KEY   (backend only — it bypasses row-level security)
#   - TENCENT_PALM_API_KEY        (backend only — the browser never calls Tencent)
#
# `pnpm build && pnpm guard:secrets` greps the built bundle for exactly those and
# fails if either turns up.

# Base URL of the PayByPalm API.
# Local:  http://localhost:8080
# Render: https://your-service.onrender.com
VITE_API_BASE_URL=http://localhost:8080
