# /etc/paybypalm/terminal.env
#
# Copy to /etc/paybypalm/terminal.env and lock it down:
#   sudo install -d -m 0755 /etc/paybypalm
#   sudo install -m 0600 -o root -g root terminal.env.example /etc/paybypalm/terminal.env
#
# This file is the ONLY place the device key lives. It is not in the repo, not
# in the JavaScript bundle, and not in any environment variable read at build
# time — see pi/README.md for why that distinction matters.

# Where the wallet + terminal app is served from.
KIOSK_URL=https://paybypalm.vercel.app/terminal

# The terminal's device key. Matches a sha256 in the terminals table.
# The seed ships pbp_dev_terminal_key_001 for development — replace it.
TERMINAL_KEY=pbp_dev_terminal_key_001
