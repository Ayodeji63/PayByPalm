# Per-user unit, installed by install.sh. Desktop autostart imports the real
# Wayland/X11 environment before starting this service; no fixed username/display.
[Unit]
Description=PayByPalm terminal kiosk
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="%h/.local/share/paybypalm/pi/paybypalm-kiosk.sh"
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
UMask=0077
