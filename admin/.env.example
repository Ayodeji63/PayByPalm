# Set NODE_ENV=production in the hosting environment when deploying.
PORT=8090
APP_ORIGIN=http://127.0.0.1:5190
# Vercel Production: APP_ORIGIN=https://admin.paybypalm.app
# Vercel Functions: NODEJS_HELPERS=0 (Express handles request parsing).
TRUST_PROXY_HOPS=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated verified PayByPalm account UUIDs, never email/user metadata roles.
ADMIN_USER_IDS=
# Generate privately with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
TERMINAL_URL=https://pay-by-palm.vercel.app/terminal

# The payment backend owns the mode. For local backend testing use
# http://127.0.0.1:8080 instead; production uses the Render origin below.
PAYMENT_API_BASE_URL=https://paybypalm-backend.onrender.com
# Configure both keys once, from the SAME Paystack business as the backend.
# The admin selects the matching key at runtime; it has no PAYSTACK_MODE switch.
# Never use a VITE_ prefix or paste secret values in chat.
# PAYSTACK_TEST_SECRET_KEY=sk_test_REPLACE_PRIVATELY
# PAYSTACK_LIVE_SECRET_KEY=sk_live_REPLACE_PRIVATELY

# Login/verification uses PAYMENT_API_BASE_URL. No Resend key or auth DB password here.
