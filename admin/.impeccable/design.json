  "narrative": {
    "northStar": "PayByPalm administration",
    "overview": "The established PayByPalm blue identity carries a clean, restrained operational interface. White work surfaces sit on a cool neutral canvas; blue identifies actions and navigation, while content and status words carry the information.\n\nDensity supports scanning and editing merchant and terminal records. Compact supporting text accompanies stronger page and panel headings, gently rounded controls and consistent outline icons. This records the completed application, merging the provisional design direction with the implemented CSS; the current surface composition remains in `.impeccable/surfaces/admin.md`. Source: [`src/style.css`](src/style.css) (root tokens, headings, shell, controls and media queries), [`src/main.tsx`](src/main.tsx) (Button, Field, Badge and workspace markup), and [`src/icons.tsx`](src/icons.tsx) (SVG geometry).",
    "keyCharacteristics": [
      "Royal blue actions and pale blue active states.",
      "White, bordered work surfaces on a cool neutral canvas.",
      "Compact UI typography with explicit labels and readable status words.",
      "Full-page forms, visible focus and responsive inventory tables."
    ],
    "rules": [
      {
        "name": "The Action and Selection Rule",
        "body": "Use blue for actions, selected navigation and contextual guidance; use named semantic treatments for success and danger.",
        "section": "colors"
      },
      {
        "name": "The Worded State Rule",
        "body": "Pair semantic color with an explicit status word or explanatory message. Color alone does not state device access or request outcome.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate work surfaces with background tone, borders and spacing. The implemented system uses no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the established PayByPalm blue, white surfaces and cool neutral canvas.",
      "Do give fields explicit labels, preserve visible keyboard focus and expose the skip-to-content link on focus.",
      "Do keep status words beside semantic colors and last-contact timestamps distinct from a claim that a device is online.",
      "Do preserve horizontal table scrolling on small screens and keep forms in a single readable column.",
      "Do place credential replacement confirmation inline and show provisioning material in its dedicated completion view."
    ],
    "donts": [
      "Don't replace the established identity with an unrelated visual world.",
      "Don't add decorative charts, hero metrics or fabricated operational data.",
      "Don't hide essential merchant or device actions to make a narrow table fit.",
      "Don't replace the consistent outline SVG icons with text glyphs."
    ]
  }
}
